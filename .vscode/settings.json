{
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 500,
  "latex-workshop.latex.autoBuild.run": "onSave",
  "latex-workshop.latex.autoBuild.interval": 1000,
  "latex-workshop.latex.build.enableMagicComments": false,
  "latex-workshop.latex.recipe.default": "LuaLaTeX + Asymptote",
  "latex-workshop.latex.outDir": "%WORKSPACE_FOLDER%/build/%RELATIVE_DIR%/%DOCFILE%",
  "latex-workshop.latex.auxDir": "%WORKSPACE_FOLDER%/build/%RELATIVE_DIR%/%DOCFILE%",
  "latex-workshop.latex.autoClean.run": "never",
  "latex-workshop.view.pdf.viewer": "tab",
  "latex-workshop.view.pdf.tab.editorGroup": "right",
  "latex-workshop.latex.recipes": [
    {
      "name": "Cached pdfLaTeX + Asymptote",
      "tools": [
        "cached"
      ]
    },
    {
      "name": "Normal pdfLaTeX + Asymptote",
      "tools": [
        "normal"
      ]
    },
    {
      "name": "LuaLaTeX + Asymptote",
      "tools": [
        "lua"
      ]
    }
  ],
  "latex-workshop.latex.tools": [
    {
      "name": "cached",
      "command": "python3",
      "args": [
        "%WORKSPACE_FOLDER%/.latex/build.py",
        "%DOC%.tex"
      ]
    },
    {
      "name": "normal",
      "command": "python3",
      "args": [
        "%WORKSPACE_FOLDER%/.latex/build.py",
        "--no-cache",
        "%DOC%.tex"
      ]
    },
    {
      "name": "lua",
      "command": "python3",
      "args": [
        "%WORKSPACE_FOLDER%/.latex/build.py",
        "--engine",
        "lualatex",
        "%DOC%.tex"
      ]
    }
  ],
  "files.exclude": {
    ".latex": true,
    ".vscode": true,
    ".devcontainer": true,
    ".github": true,
    ".gitattributes": true,
    ".gitignore": true,
    ".latexmkrc": true,
    "dotfiles": true,
    "tests": true,
    "tools": true,
    "install.sh": true
  },
  "explorer.compactFolders": false,
  "search.exclude": {
    "**/build/**": true
  }
}
